# ==============================================================================
# SEGURANÇA CRÍTICA: NUNCA COLOQUE ESSES VALORES NO CÓDIGO FONTE OU NO GIT
# Configure estas variáveis no painel da Vercel / Servidor (Settings -> Environment Variables)
# ==============================================================================

# Integração Asaas API v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=
ASAAS_ENVIRONMENT=production # 'production' ou 'sandbox'

# Credenciais de Serviço do Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
